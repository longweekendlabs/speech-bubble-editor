/*
 * Speech Bubble Editor — dark theme (v4.0.4)
 *
 * Design tokens:
 *   App background:      #161616
 *   Panels / TopBar bg:  #1e1e1e
 *   Section bg:          #232323
 *   Canvas bg:           #121212
 *   Panel border:        #2a2a2a
 *   Input bg:            #2a2a2a
 *   Input border:        #3a3a3a
 *   Text primary:        #e6e6e6
 *   Text secondary:      #9a9a9a
 *   Text muted:          #5a5a5a
 *   Btn hover:           #333333
 *   Btn active:          #3a3a3a
 *   Accent (teal):       #ff8a3d
 *   Export CTA:          #ff8a3d
 *   Export CTA hover:    #ffa163
 *   Danger:              #f87171
 *   Autosave dot:        #22c55e
 */

/* ── Base ─────────────────────────────────────────────────────────── */
QWidget {
    background-color: #161616;
    color: #e6e6e6;
    font-size: 12px;
}

QMainWindow, QDialog {
    background-color: #161616;
}

/* ── Buttons ──────────────────────────────────────────────────────── */
QPushButton {
    background-color: #232323;
    color: #e6e6e6;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    padding: 0 10px;
}

QPushButton:hover {
    background-color: #333333;
    border-color: #4a4a4a;
}

QPushButton:pressed {
    background-color: #3a3a3a;
}

QPushButton:disabled {
    background-color: #161616;
    color: #5a5a5a;
    border-color: #2a2a2a;
}

QToolButton {
    background-color: #232323;
    color: #e6e6e6;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    padding: 0 8px;
}

QToolButton:hover {
    background-color: #333333;
    border-color: #4a4a4a;
}

QToolButton:pressed, QToolButton:checked {
    background-color: #3a3a3a;
    border-color: #3a3a3a;
}

QToolButton:disabled {
    background-color: #161616;
    color: #5a5a5a;
    border-color: #2a2a2a;
}

/* Text-style preset buttons in the inspector */
#PresetButton {
    padding: 5px 4px;
    font-size: 11px;
}
#PresetButton:hover {
    border-color: #ff8a3d;
    color: #ffffff;
}

/* ── Labels ───────────────────────────────────────────────────────── */
QLabel {
    background-color: transparent;
    color: #e6e6e6;
}

/* ── Inputs ───────────────────────────────────────────────────────── */
QComboBox, QFontComboBox {
    background-color: #2a2a2a;
    color: #e6e6e6;
    border: 1px solid #3a3a3a;
    border-radius: 5px;
    padding: 2px 6px;
    selection-background-color: #ff8a3d;
    selection-color: #161616;
}

QComboBox:hover, QFontComboBox:hover {
    border-color: #4a4a4a;
}

QComboBox::drop-down, QFontComboBox::drop-down {
    border: none;
    width: 18px;
}

QComboBox QAbstractItemView, QFontComboBox QAbstractItemView {
    background-color: #232323;
    color: #e6e6e6;
    selection-background-color: #333333;
    selection-color: #e6e6e6;
    border: 1px solid #2a2a2a;
}

QComboBox:disabled, QFontComboBox:disabled {
    background-color: #161616;
    color: #5a5a5a;
    border-color: #2a2a2a;
}

QSpinBox, QDoubleSpinBox {
    background-color: #2a2a2a;
    color: #e6e6e6;
    border: 1px solid #3a3a3a;
    border-radius: 5px;
    padding: 2px 4px;
    selection-background-color: #ff8a3d;
    selection-color: #161616;
}

QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: #161616;
    color: #5a5a5a;
    border-color: #2a2a2a;
}

QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background-color: #3a3a3a;
    border: none;
    width: 14px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #4a4a4a;
}

/* ── Text edit ────────────────────────────────────────────────────── */
QTextEdit {
    background-color: #2a2a2a;
    color: #e6e6e6;
    border: 1px solid #3a3a3a;
    border-radius: 5px;
    padding: 6px;
}

/* ── Sliders ──────────────────────────────────────────────────────── */
QSlider::groove:horizontal {
    background-color: #2a2a2a;
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: #ff8a3d;
    border: 2px solid #161616;
    width: 12px;
    height: 12px;
    border-radius: 6px;
    margin: -4px 0;
}

QSlider::sub-page:horizontal {
    background-color: #ff8a3d;
    border-radius: 2px;
}

/* ── Checkboxes ───────────────────────────────────────────────────── */
QCheckBox {
    color: #e6e6e6;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #3a3a3a;
    border-radius: 3px;
    background-color: #2a2a2a;
}

QCheckBox::indicator:checked {
    background-color: #ff8a3d;
    border-color: #ff8a3d;
}

QCheckBox::indicator:unchecked:hover {
    border-color: #ff8a3d;
}

/* ── Scrollbars ───────────────────────────────────────────────────── */
QScrollBar:horizontal {
    background-color: #161616;
    height: 8px;
    margin: 0;
}

QScrollBar:vertical {
    background-color: #161616;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:horizontal, QScrollBar::handle:vertical {
    background-color: #2a2a2a;
    border-radius: 4px;
    min-width: 20px;
    min-height: 20px;
}

QScrollBar::handle:horizontal:hover, QScrollBar::handle:vertical:hover {
    background-color: #3a3a3a;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}

QScrollArea {
    background-color: #161616;
    border: none;
}

/* ── GraphicsView (canvas) ────────────────────────────────────────── */
QGraphicsView {
    background-color: #121212;
    border: none;
}

QGraphicsView > QWidget {
    background-color: #121212;
}

#CanvasArea {
    background-color: #121212;
}

/* ── Tooltips ─────────────────────────────────────────────────────── */
QToolTip {
    background-color: #232323;
    color: #e6e6e6;
    border: 1px solid #2a2a2a;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
}

/* ── Menus ────────────────────────────────────────────────────────── */
QMenu {
    background-color: #232323;
    color: #e6e6e6;
    border: 1px solid #2a2a2a;
    border-radius: 6px;
    padding: 4px 0;
}

QMenu::item {
    padding: 6px 20px;
}

QMenu::item:selected {
    background-color: #333333;
    color: #e6e6e6;
}

QMenu::item:checked {
    color: #ff8a3d;
}

QMenu::separator {
    background-color: #2a2a2a;
    height: 1px;
    margin: 4px 8px;
}

/* ── Progress bar ─────────────────────────────────────────────────── */
QProgressBar {
    background-color: #2a2a2a;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    text-align: center;
    color: #e6e6e6;
}

QProgressBar::chunk {
    background-color: #ff8a3d;
    border-radius: 3px;
}

/* ── Status bar ───────────────────────────────────────────────────── */
QStatusBar {
    background-color: #1e1e1e;
    color: #9a9a9a;
    border-top: 1px solid #2a2a2a;
    font-size: 11px;
}

/* ── Splitter handle ──────────────────────────────────────────────── */
QSplitter::handle:horizontal {
    background-color: #2a2a2a;
    width: 1px;
}

/* ── TopBar ───────────────────────────────────────────────────────── */
#TopBar {
    background-color: #1e1e1e;
    border-bottom: 1px solid #2a2a2a;
}

#TopBarMark {
    color: #ff8a3d;
    font-size: 20px;
    font-weight: 700;
}

#TopBarLogo {
    color: #e6e6e6;
    font-size: 13px;
    font-weight: 700;
}

#TopBarByline {
    color: #5a5a5a;
    font-size: 11px;
    font-weight: 400;
}

#TopBarSeparator {
    background-color: #2a2a2a;
    border: none;
}

#TopBar QPushButton,
#TopBar QToolButton,
#ZoomBtn {
    background-color: #232323;
    color: #e6e6e6;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    font-size: 12px;
    padding: 0 10px;
}

#TopBar QPushButton:hover,
#TopBar QToolButton:hover,
#ZoomBtn:hover {
    background-color: #333333;
    border-color: #4a4a4a;
}

#TopBar QPushButton:disabled,
#TopBar QToolButton:disabled {
    background-color: #161616;
    color: #5a5a5a;
    border-color: #2a2a2a;
}

#BtnExport {
    background-color: #ff8a3d;
    color: #ffffff;
    border: none;
    font-weight: 600;
}

#BtnExport:hover {
    background-color: #ffa163;
}

#BtnExport:pressed {
    background-color: #e07331;
}

#BtnExport:disabled {
    background-color: #1e1e1e;
    color: #5a5a5a;
    border: 1px solid #2a2a2a;
}

/* ── ContextToolbar ───────────────────────────────────────────────── */
#ContextToolbar {
    background-color: #232323;
    border-bottom: 1px solid rgba(255, 138, 61, 0.3);
}

#ContextChip {
    background-color: rgba(255, 138, 61, 0.15);
    border: 1px solid rgba(255, 138, 61, 0.5);
    border-radius: 5px;
    color: #ff8a3d;
    font-size: 11px;
    font-weight: 600;
    padding: 2px 8px;
}

#ContextBtn {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    color: #e6e6e6;
    font-size: 11px;
    padding: 0;
    min-width: 0;
}

#ContextBtn:hover {
    background-color: #333333;
    border-color: #3a3a3a;
}

#ContextBtn:pressed {
    background-color: #3a3a3a;
}

#ContextDeleteBtn {
    color: #f87171;
}

#ContextDeleteBtn:hover {
    background-color: rgba(248, 113, 113, 0.15);
    border-color: rgba(248, 113, 113, 0.5);
    color: #f87171;
}

#ContextSep {
    background-color: #2a2a2a;
    border: none;
}

/* ── ToolSidebar ──────────────────────────────────────────────────── */
#ToolSidebar {
    background-color: #1e1e1e;
    border-right: 1px solid #2a2a2a;
}

#ToolSidebar QToolButton {
    background-color: transparent;
    color: #9a9a9a;
    border: 1px solid transparent;
    border-radius: 8px;
    font-size: 11px;
    padding: 4px 2px;
}

#ToolSidebar QToolButton:hover {
    background-color: #333333;
    color: #e6e6e6;
    border-color: #3a3a3a;
}

#ToolSidebar QToolButton:checked {
    background-color: #3a3a3a;
    color: #ff8a3d;
    border-left: 3px solid #ff8a3d;
    border-top: 1px solid #3a3a3a;
    border-right: 1px solid #3a3a3a;
    border-bottom: 1px solid #3a3a3a;
}

#ToolSidebar QToolButton:disabled {
    color: #2a2a2a;
}

#SidebarCollapse {
    background-color: transparent;
    color: #5a5a5a;
    border: 1px solid #2a2a2a;
    border-radius: 5px;
    font-size: 12px;
    padding: 0;
}

#SidebarCollapse:hover {
    background-color: #333333;
    color: #9a9a9a;
    border-color: #3a3a3a;
}

/* ── InspectorDock ────────────────────────────────────────────────── */
#InspectorDock {
    background-color: #1e1e1e;
    border-left: 1px solid #2a2a2a;
}

#InspectorTabBar {
    background-color: #1e1e1e;
}

#InspectorTabBar::tab {
    background-color: #1e1e1e;
    color: #9a9a9a;
    min-width: 0px;
    padding: 10px 6px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 12px;
}

#InspectorTabBar::tab:selected {
    color: #e6e6e6;
    border-bottom: 2px solid #ff8a3d;
    font-weight: 600;
}

#InspectorTabBar::tab:hover:!selected {
    color: #e6e6e6;
    background-color: #232323;
}

#InspectorPage {
    background-color: #1e1e1e;
}

#InspectorSection {
    background-color: #1e1e1e;
    border-bottom: 1px solid #2a2a2a;
}

#InspectorSectionHeader {
    background-color: #1e1e1e;
}

#InspectorSectionTitle {
    color: #9a9a9a;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
}

#InspectorSectionBody {
    background-color: #1e1e1e;
}

#InspectorLabel {
    color: #9a9a9a;
    font-size: 12px;
    min-width: 52px;
}

#InspectorHint {
    color: #5a5a5a;
    font-size: 10px;
}

#InspectorTextEdit {
    background-color: #2a2a2a;
    color: #e6e6e6;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    padding: 8px 10px;
    font-size: 13px;
}

#InspectorTextEdit:focus {
    border-color: #ff8a3d;
}

/* ── Style picker buttons ─────────────────────────────────────────── */
#StyleButton {
    background-color: #2a2a2a;
    color: #e6e6e6;
    border: 2px solid #3a3a3a;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 700;
    padding: 0;
}

#StyleButton:checked {
    background-color: rgba(255, 138, 61, 0.12);
    border: 2px solid #ff8a3d;
    color: #ff8a3d;
}

#StyleButton:hover {
    background-color: #333333;
    border-color: #4a4a4a;
}

#StyleButton:disabled {
    background-color: #1e1e1e;
    border-color: #2a2a2a;
    color: #5a5a5a;
}

/* ── Alignment buttons ────────────────────────────────────────────── */
#AlignButton {
    background-color: #2a2a2a;
    color: #e6e6e6;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    font-weight: 600;
    font-size: 12px;
    padding: 0;
    min-width: 0;
}

#AlignButton:checked {
    background-color: rgba(255, 138, 61, 0.15);
    border-color: #ff8a3d;
    color: #ff8a3d;
}

#AlignButton:hover {
    background-color: #333333;
    border-color: #4a4a4a;
}

#AlignButton:disabled {
    background-color: #1e1e1e;
    border-color: #2a2a2a;
    color: #5a5a5a;
}

/* ── Arrange buttons ──────────────────────────────────────────────── */
#ArrangeButton {
    background-color: #2a2a2a;
    color: #e6e6e6;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    font-size: 11px;
    padding: 0;
    min-width: 0;
}

#ArrangeButton:hover {
    background-color: #333333;
    border-color: #4a4a4a;
}

/* ── Layers list ──────────────────────────────────────────────────── */
#LayersList {
    background-color: #1e1e1e;
    color: #e6e6e6;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    outline: none;
}

#LayersList::item {
    min-height: 32px;
    padding: 7px 10px;
    margin: 3px 0;
    background-color: #2a2a2a;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
}

#LayersList::item:selected {
    background-color: rgba(255, 138, 61, 0.15);
    color: #e6e6e6;
    border: 1px solid #ff8a3d;
}

#LayersList::item:hover:!selected {
    background-color: #333333;
}

#LayerActionButton {
    background-color: #2a2a2a;
    color: #e6e6e6;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    padding: 0 10px;
}

#LayerActionButton:hover {
    background-color: #333333;
    border-color: #ff8a3d;
}

/* ── Timecode label ───────────────────────────────────────────────── */
#TimecodeLabel {
    color: #ff8a3d;
    font-family: monospace;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.05em;
    background-color: transparent;
}

/* ── Font tiles (visual font picker) ─────────────────────────────── */
#FontTile {
    background-color: #2a2a2a;
    color: #e6e6e6;
    border: 2px solid #3a3a3a;
    border-radius: 8px;
    padding: 2px 4px;
}

#FontTile:checked {
    background-color: rgba(255, 138, 61, 0.12);
    border-color: #ff8a3d;
    color: #ff8a3d;
}

#FontTile:hover {
    background-color: #333333;
    border-color: #4a4a4a;
}

#FontTile:disabled {
    background-color: #1e1e1e;
    border-color: #2a2a2a;
    color: #5a5a5a;
}

/* ── Primary action button (crop dialog etc.) ────────────────────── */
#PrimaryButton {
    background-color: #ff8a3d;
    color: #121212;
    border: none;
    border-radius: 6px;
    font-weight: 700;
}

#PrimaryButton:hover {
    background-color: #ffa163;
}

/* ── Inspector empty state ───────────────────────────────────────── */
#InspectorPlaceholder {
    color: #6f6f6f;
    font-size: 12px;
    line-height: 150%;
}

/* ── Preset toggle row (shadow None/Soft/Solid) ──────────────────── */
#PresetToggle {
    background-color: #2a2a2a;
    color: #e6e6e6;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    font-size: 12px;
}
#PresetToggle:checked {
    background-color: rgba(255, 138, 61, 0.14);
    border-color: #ff8a3d;
    color: #ff8a3d;
}
#PresetToggle:hover:!checked {
    background-color: #333333;
    border-color: #4a4a4a;
}
#PresetToggle:disabled { color: #5a5a5a; border-color: #2a2a2a; }
